# SIS configuration
# =================
#
# Point the SIS_CONFIG_YAML environment variable at a copy of this file. It is
# the only environment variable SIS reads.
#
# The sections follow the source tree, so a key's path tells you which code
# folder uses it:
#
#   sis.httpserver                  -> internal/httpserver
#   sis.auth                        -> internal/auth
#   sis.adapter.inbound.oeapi       -> internal/adapter/inbound/oeapi
#   sis.adapter.outbound.postgres   -> internal/adapter/outbound/postgres
#   sis.file_import                 -> internal/fileimport
#
# Every key is documented in pkg/model/config.go. Rules:
#   - Keys you leave out take the default shown here.
#   - Unknown or misspelled keys stop SIS at startup.
#   - Durations use Go syntax: 500ms, 15s, 10m, 1h.

common:
  # true enforces production rules: every sis.auth.issuers entry must use
  # https and have an audience. Set true on every shared deployment.
  production: false
  log:
    level: info   # debug | info | warn | error
    json: true    # true: one JSON object per line; false: readable text

sis:
  # -- internal/httpserver -----------------------------------------------------
  # One listener serves every API and the admin web UI.
  httpserver:
    addr: ":8080"           # host:port; startup fails if it is taken
    read_timeout: 15s       # max time to receive a request
    write_timeout: 15s      # max time to send a response
    shutdown_timeout: 10s   # grace period for in-flight requests on SIGTERM
    web:
      # Directory with the built admin UI (index.html + assets/). The Docker
      # image ships it at /web. Empty serves the APIs only.
      root: ""
    swagger:
      # Serve the /api/v1 API docs (Swagger UI) at /swagger/index.html. The
      # page is public; requests sent from it still need a Bearer token.
      enabled: true
    tls:
      # Serve https from these PEM files (paths relative to this file). Empty
      # serves plain http, e.g. behind a TLS-terminating proxy. The web UI's
      # sign-in needs https, or http on localhost. `make pki` creates dev
      # files in developer_tools/pki.
      cert_file: ""
      key_file: ""

  # -- internal/auth -----------------------------------------------------------
  # SIS issues no tokens and stores no passwords. Every API call needs an
  # access token (JWT) from one of these issuers, and the token's scope claim
  # decides what the caller may do:
  #   sis.read   GET /api/v1/*, POST /api/v1/parse, all of /oeapi and /eduapi
  #   sis.write  POST/PUT/DELETE /api/v1/*, POST /api/v1/populate
  # sis.write does not include sis.read. People and machine clients are
  # treated the same. Grant, change and revoke access at the issuer; SIS
  # needs no restart. Adding or removing an issuer does need one.
  auth:
    issuers:
      - issuer: "https://idp.example.org/realms/sis"   # must equal the tokens' iss claim
        # Must be in the tokens' aud claim, so tokens the issuer mints for
        # other services are refused. Required when common.production is true.
        audience: "sis"
        # Optional. Where to fetch the signing keys; empty finds them through
        # the issuer's discovery document. Set it when SIS reaches the
        # issuer under another address than iss (e.g. a container name).
        jwks_url: ""
    # Extra CA certificates (PEM) for the issuers' https certificates, on top
    # of the system roots, e.g. developer_tools/pki/rootCA.crt in development.
    ca_files: []

  # -- internal/adapter --------------------------------------------------------
  adapter:
    # APIs clients call. Each list endpoint has a default page size and a
    # maximum; larger requests are lowered to the maximum, which must be at
    # least the default.
    inbound:
      authapi:              # GET /auth/config: how the web UI signs in
        # The browser signs in here (authorization code + PKCE) and sends
        # the token to the APIs. Must be one of sis.auth.issuers, and must
        # allow CORS from the web UI's origin. Empty disables web sign-in.
        issuer: "https://idp.example.org/realms/sis"
        # The web UI's public client at the issuer; redirect URI = the web
        # UI's root, e.g. https://sis.example.org/
        client_id: "sis-web"
        scope: "openid sis.read sis.write"   # requested; the issuer decides what is granted
      restadmin:            # /api/v1 (read/write)   ?limit=&offset=
        default_limit: 50
        max_limit: 500
      oeapi:                # /oeapi (Open Education API v6, read-only)   ?pageNumber=&pageSize=
        default_page_size: 10
        max_page_size: 500
      eduapi:               # /eduapi (Edu-API v1, read-only)   ?limit=&offset=
        default_limit: 100
        max_limit: 500
      convertapi:           # POST /api/v1/parse and /api/v1/populate (ELM documents)
        # Request size cap for these two endpoints (bytes); every other
        # endpoint is capped at 1 MiB. Larger requests get 413.
        max_body_bytes: 5242880
        # Replaces sis.httpserver.write_timeout for these two endpoints:
        # populate stores a large document record by record.
        write_timeout: 2m

    # Systems SIS calls out to.
    outbound:
      postgres:
        # Empty keeps all data in memory and loses it on restart: try-out
        # only. Migrations run automatically at startup.
        # localhost is for running SIS on the host against the compose
        # database. When SIS itself runs under docker compose (this file
        # mounted as config.yaml), use the service name instead:
        #   postgres://sis:sis@postgres:5432/sis?sslmode=disable
        connection_string: "postgres://sis:sis@localhost:5432/sis?sslmode=disable"
      events:
        # Events are logged today; NATS publishing is not implemented yet.
        enabled: false
        url: "nats://localhost:4222"
        subject: "sis.events"

    # -- internal/adapter/sweeper ----------------------------------------------
    # Records loaded with a ttl (POST /api/v1/populate) stop being served the
    # moment they expire; the sweeper then deletes them on this interval.
    sweeper:
      interval: 1m

  # -- internal/fileimport -----------------------------------------------------
  # Records loaded from JSON files at every start, in order, e.g. fake
  # students for development. Paths are relative to this file. Records are
  # upserted by sourcedId, so each start resets them to the file's content.
  # Any error stops startup. Format: see internal/fileimport.
  file_import:
    files: []
    # files:
    #   - testdata/fake_students.json
